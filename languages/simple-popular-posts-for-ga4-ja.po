msgstr "Simple Popular Posts"

msgid "Simple Popular Posts (GA4)"
msgstr "Simple Popular Posts (GA4)"

msgid "Simple Popular Posts for GA4"
msgstr "Simple Popular Posts for GA4"

msgid "Simple Popular Posts for GA4 Settings"
msgstr "Simple Popular Posts for GA4 設定"

msgid "Specify Post IDs to exclude from the ranking."
msgstr "ランキングから除外したい記事のIDを指定します。"

msgid "Start Time"
msgstr "開始時間"

msgid "System Status"
msgstr "システムステータス"

msgid "Table: <code>%s</code>"
msgstr "使用テーブル: <code>%s</code>"

msgid "Tag ID:"
msgstr "タグID:"

msgid "The JSON key is securely encrypted using your WordPress installation's unique salt keys. If you migrate your site to a new server or change your wp-config.php security salts, you must re-save your JSON key here to generate a new valid encryption."
msgstr "JSONキーは、ご利用のWordPress固有のソルトキーを使用して安全に暗号化されます。サイトを新しいサーバーに移行した場合や、wp-config.php のセキュリティソルトを変更した場合は、暗号化をやり直すためにJSONキーをこの画面で再度保存し直す必要があります。"

msgid "The period for which GA4 data is aggregated (7 days or 30 days)."
msgstr "GA4データの集計期間 (7日間または30日間)。"

msgid "Thumbnail Size (px):"
msgstr "サムネイルサイズ (px):"

msgid "Time Range:"
msgstr "集計期間:"

msgid "Title Tag:"
msgstr "タイトルタグ:"

msgid "Title:"
msgstr "タイトル:"

msgid "Truncate the post title to this number of characters. 0 to disable."
msgstr "記事タイトルを指定した文字数で切り詰めます。0で無効化。"

msgid "Uninstall Settings"
msgstr "アンインストール設定"

msgid "Updated: %s posts"
msgstr "更新数: %s 件"

